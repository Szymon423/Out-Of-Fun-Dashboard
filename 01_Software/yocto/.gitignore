# Build output and caches stay local; only the build configuration is versioned.
/build/*
!/build/conf/
/build/conf/*
!/build/conf/local.conf
!/build/conf/bblayers.conf
!/build/conf/toolcfg.conf
/downloads/
/sstate-cache/
# RAUC signing keys never go to git; keep an encrypted backup elsewhere.
/keys/
