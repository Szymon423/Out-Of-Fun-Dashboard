# Out Of Fun Dashboard. Both rootfs slots use this file, so nothing in it depends on the
# slot: the root file system is the one U-Boot passes as root= (/dev/root).
/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# Boot partition (firmware, config.txt, U-Boot, boot.scr), read-only.
# To change a file: mount -o remount,rw /boot/firmware
/dev/mmcblk0p1       /boot/firmware       vfat       ro,nofail             0  0
# Data that survives updates, grown to the end of the card on first boot.
/dev/mmcblk0p4       /data                ext4       defaults,x-systemd.growfs  0  2
