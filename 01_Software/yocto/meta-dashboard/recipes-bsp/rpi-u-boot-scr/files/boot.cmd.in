# Out Of Fun Dashboard: A/B boot for RAUC (docs/ota-rauc.md).
# Slot A is mmcblk0p2 and slot B mmcblk0p3. BOOT_ORDER lists the slots in the order to
# try, BOOT_A_LEFT and BOOT_B_LEFT how many tries each has left. Every boot uses up one
# try and "rauc status mark-good" in the booted system gives it back. RAUC puts a freshly
# updated slot first in BOOT_ORDER.

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv rauc_slot
setenv rauc_part
for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${rauc_slot}" = "x"; then
    if test "x${BOOT_SLOT}" = "xA"; then
      if itest ${BOOT_A_LEFT} -gt 0; then
        setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
        setenv rauc_slot A
        setenv rauc_part 2
      fi
    elif test "x${BOOT_SLOT}" = "xB"; then
      if itest ${BOOT_B_LEFT} -gt 0; then
        setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
        setenv rauc_slot B
        setenv rauc_part 3
      fi
    fi
  fi
done

if test "x${rauc_slot}" = "x"; then
  echo "No slot has tries left, giving both slots 3 tries again"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

# Save the used-up try before booting, so a hang or a crash counts as well.
saveenv

fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs
setenv bootargs "${bootargs} root=/dev/mmcblk0p${rauc_part} rauc.slot=${rauc_slot} panic=5"
echo "Booting slot ${rauc_slot} from mmcblk0p${rauc_part}"
if load @@BOOT_MEDIA@@ 0:${rauc_part} ${kernel_addr_r} /boot/@@KERNEL_IMAGETYPE@@; then
  @@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
fi

# No kernel in this slot, or it did not start: reset, which uses up another try.
echo "Slot ${rauc_slot} did not boot"
reset
