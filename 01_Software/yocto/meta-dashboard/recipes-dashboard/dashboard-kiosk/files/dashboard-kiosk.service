[Unit]
Description=Dashboard kiosk (WPE WebKit in Weston)
Requires=weston.service
After=weston.service
# Restarting Weston restarts the kiosk too.
PartOf=weston.service

[Service]
User=weston
Group=weston
EnvironmentFile=/etc/default/dashboard-kiosk
Environment=WAYLAND_DISPLAY=/run/wayland-0
Environment=XDG_RUNTIME_DIR=/run/dashboard-kiosk
RuntimeDirectory=dashboard-kiosk
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/dashboard-launcher ${DASHBOARD_URL}
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
